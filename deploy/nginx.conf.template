# Use Docker's embedded DNS so backend/frontend hostnames are re-resolved at
# runtime. Without this, nginx caches upstream IPs at startup and starts
# returning 502 whenever the backend/frontend container is recreated and gets a
# new IP (which happens on every image update).
resolver 127.0.0.11 valid=10s ipv6=off;

# This file is processed by the nginx:alpine envsubst entrypoint. Only the
# variables listed in NGINX_ENVSUBST_FILTER_VARIABLES (see docker-compose.prod.yml)
# are substituted; nginx runtime variables like $host and $remote_addr are
# preserved verbatim.

server {
    listen 80;
    server_name _;

    client_max_body_size 50m;

    # Upstream targets resolved per request via the resolver above.
    set $backend_upstream  http://backend:8080;
    set $frontend_upstream http://frontend:3000;

    # API and auth — route directly to Go backend
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /auth/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check
    location = /health {
        proxy_pass $backend_upstream;
    }

    # WebSocket — direct to backend with upgrade support
    location /ws {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Firebase auth helper — required for Google sign-in via signInWithRedirect
    # on PWAs served from a custom domain. The Firebase Web SDK redirects the
    # user to /__/auth/handler on the app's origin; that page in turn talks to
    # Google and posts the credential back via same-origin storage. Without
    # this proxy, getRedirectResult() returns null in PWA mode because the
    # *.firebaseapp.com helper page is cross-origin to the app.
    #
    # The proxy target is derived from FIREBASE_PROJECT_ID (every Firebase
    # project exposes its auth helper at <project>.firebaseapp.com).
    # NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN must be set to the app's own domain at
    # frontend build time so the SDK targets this proxy. See SELF_HOSTING.md.
    location /__/auth/ {
        proxy_pass https://${FIREBASE_PROJECT_ID}.firebaseapp.com;
        proxy_set_header Host ${FIREBASE_PROJECT_ID}.firebaseapp.com;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location = /__/firebase/init.json {
        proxy_pass https://${FIREBASE_PROJECT_ID}.firebaseapp.com;
        proxy_set_header Host ${FIREBASE_PROJECT_ID}.firebaseapp.com;
        proxy_ssl_server_name on;
    }

    # Everything else — Next.js frontend
    location / {
        proxy_pass $frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

